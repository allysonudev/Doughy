"onboarding_volume_body" = "हर चीज़ आसानी से तौली नहीं जा सकती। आम सामग्रियों के लिए मानक द्रव्यमान-से-आयतन रूपांतरण होते हैं। अपने ख़ुद के कभी भी जोड़ें।";
"whats_new_volume_body" = "हर चीज़ आसानी से तौली नहीं जा सकती। आम सामग्रियों के लिए मानक द्रव्यमान-से-आयतन रूपांतरण होते हैं। अपने ख़ुद के कभी भी जोड़ें।";
"onboarding_scan_title" = "रेसिपी बनाएं या स्कैन करें";
"onboarding_scan_body" = "किसी रेसिपी को प्रतिशत या वज़न के अनुसार टाइप करें — या Apple Intelligence के ऑन-डिवाइस मॉडल से किसी रेसिपी की फ़ोटो लें या स्क्रीनशॉट स्कैन करें और सेकंडों में अपनी रेसिपी बनाएं। iPhone 15 या बाद के मॉडल की आवश्यकता है।";
"onboarding_private_title" = "पूरी तरह मुफ़्त। पूरी तरह निजी।";
